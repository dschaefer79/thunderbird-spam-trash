{
  "manifest_version": 3,
  "name": "Empty Spam & Trash",
  "description": "One button to permanently delete everything in Spam/Junk and Trash across all accounts.",
  "version": "1.1.0",
  "author": "dschaefer79",
  "browser_specific_settings": {
    "gecko": {
      "id": "empty-spam-trash@dschaefer79",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["accountsRead", "messagesRead", "messagesDelete"],
  "action": {
    "default_title": "Empty Spam & Trash",
    "default_label": "Empty Spam & Trash",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "icons": { "64": "icon.svg" }
}
